{
  "name": "inkverse",
  "version": "1.0.0",
  "private": true,
  "description": "INKVERSE\u00ae \u2014 Premium 3D Tattoo Discovery & Virtual Try-On",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:models": "python3 tools/assets/dump.py && python3 tools/assets/export_glb.py",
    "assets:textures": "python3 tools/assets/bake_textures.py",
    "assets:tattoos": "python3 tools/assets/tattoos_src.py && node tools/assets/rasterize.mjs",
    "check": "npm run typecheck && npm run test && node tools/checks/check_shader.mjs",
    "assets:regions": "python3 tools/assets/bake_regions.py && python3 tools/assets/region_metrics.py",
    "assets:editorial": "python3 tools/assets/render_editorial.py all"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.5.0",
    "geist": "^1.8.2",
    "lucide-react": "^0.545.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "jsdom": "^28.0.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
